# Database (MariaDB via Prisma)
DATABASE_URL="mysql://app_user:password@localhost:3306/security_awareness"

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=

# Dashboard password
DASHBOARD_PASSWORD=

# AES-256 encryption key for emails — must be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Server port (optional, defaults to 3000)
PORT=3000

NODE_ENV=development
