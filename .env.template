# MariaDB — used by docker-compose
DB_ROOT_PASSWORD=
DB_NAME=security_awareness
DB_USER=app_user
DB_PASSWORD=

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=

# Dashboard password
DASHBOARD_PASSWORD=

# AES-256 key for email encryption — exactly 64 hex chars (32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Port exposed on the host for the frontend (nginx), defaults to 80
HTTP_PORT=80
